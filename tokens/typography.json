{
  "families": [
    "Be Vietnam Pro",
    "Be Vietnam",
    "Cormorant Garamond",
    "Pinyon Script"
  ],
  "scale": {
    "heading-1": {
      "fontFamily": "Be Vietnam Pro",
      "fontSize": "360px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "heading-2": {
      "fontFamily": "Be Vietnam Pro",
      "fontSize": "300px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "heading-3": {
      "fontFamily": "Be Vietnam Pro",
      "fontSize": "240px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "body": {
      "fontFamily": "Be Vietnam Pro",
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": 1.6,
      "source": "css"
    },
    "button": {
      "fontFamily": "Be Vietnam Pro",
      "fontSize": "14px",
      "fontWeight": "500",
      "lineHeight": 1.4,
      "source": "css"
    },
    "caption": {
      "fontFamily": "Be Vietnam Pro",
      "fontSize": "13px",
      "fontWeight": "400",
      "lineHeight": null,
      "source": "css"
    }
  },
  "fontFaces": [
    {
      "family": "Be Vietnam Pro",
      "src": "https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700&display=swap",
      "format": "google-fonts",
      "weight": "300-800"
    },
    {
      "family": "Cormorant Garamond",
      "src": "https://www.nagicreative.com/fonts/CormorantGaramond-Medium.otf",
      "format": "opentype",
      "weight": "500"
    },
    {
      "family": "Pinyon Script",
      "src": "https://www.nagicreative.com/fonts/PinyonScript-Regular.ttf",
      "format": "truetype",
      "weight": "400"
    }
  ],
  "rules": {
    "maxSizesPerScreen": 4,
    "headingFontFamily": "Be Vietnam Pro",
    "buttonFontFamily": "Be Vietnam Pro",
    "headingWeightRange": "500-700",
    "bodyWeight": 400,
    "lineHeightBody": 1.6,
    "lineHeightHeading": 1.15
  }
}