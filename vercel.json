{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hemnhaliving.com"
        }
      ],
      "destination": "https://hemnhaliving.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/homestay/trua-he",
      "destination": "/homestay/mo-trua",
      "statusCode": 301
    },
    {
      "source": "/en/homestay/trua-he",
      "destination": "/en/homestay/mo-trua",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
